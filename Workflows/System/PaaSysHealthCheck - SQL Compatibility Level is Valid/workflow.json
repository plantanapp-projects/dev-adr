          },
          {
            "Id": 11622,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 2574,
            "Name": "SqlQuery",
            "Value": "SELECT \r\n    1 AS resourceId,\r\n    CASE \r\n        WHEN d.compatibility_level < 130 THEN 'Critical'\r\n        WHEN d.compatibility_level = 130 THEN 'Medium'\r\n        WHEN d.compatibility_level = 140 THEN 'Warning'\r\n    END AS severity,\r\n    JSON_QUERY(\r\n        (\r\n            SELECT \r\n                CASE \r\n                    WHEN d.compatibility_level < 130 \r\n                        THEN 'Database compatibility level ' + CAST(d.compatibility_level AS VARCHAR(10)) + \r\n                             ' is below the minimum required (130 / SQL Server 2016) for Plant an App 1.28.'\r\n                    \r\n                    WHEN d.compatibility_level = 130 \r\n                        THEN 'Database is at minimum supported compatibility level (130 / SQL Server 2016). Consider upgrading to 150+ for best performance and compatibility.'\r\n                    \r\n                    WHEN d.compatibility_level = 140 \r\n                        THEN 'Database is on SQL Server 2017 compatibility (140). Supported, but upgrading to 150+ (SQL Server 2019) is recommended.'\r\n                END AS errorMessage\r\n            FOR JSON PATH, WITHOUT_ARRAY_WRAPPER\r\n        )\r\n    ) AS properties\r\nFROM sys.databases d\r\nWHERE d.name = DB_NAME()\r\n  AND d.compatibility_level < 150\r\nFOR JSON PATH;",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
            "LastModifiedBy": null
