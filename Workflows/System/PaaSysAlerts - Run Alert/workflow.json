            "ActionId": 2582,
            "Name": "SqlQuery",
            "Value": "UPDATE paa.AlertType\nSET\n    IsHealthy = @IsHealthy,\n    LastModifiedBy = 1,\n    LastModifiedDate = SYSDATETIMEOFFSET(),\n    LastRun = @LastRun,\n    LastRunDurationSec = DATEDIFF(MILLISECOND, @Start, SYSDATETIMEOFFSET()) / 1000.0,\n    NextRun = @NextRun,\n    LastError = null\nWHERE Id = @AlertTypeId",
