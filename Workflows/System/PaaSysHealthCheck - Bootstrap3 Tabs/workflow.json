          },
          {
            "Id": 11612,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 2573,
            "Name": "SqlQuery",
            "Value": "WITH TabsProCTE AS\r\n(\r\n    SELECT\r\n        ts.ModuleId AS resourceId,\r\n        'Medium' AS severity,\r\n        JSON_QUERY\r\n        (\r\n            (\r\n                SELECT\r\n                    t.TabID AS PageNumber,\r\n                    t.TabName AS PageName,\r\n                    tm.ModuleTitle,\r\n                    tm.PaneName,\r\n                    t.PortalID AS PortalId,\r\n                    m.ModuleID,\r\n                    '1' as PAA_BlocksUpgrade\r\n                FOR JSON PATH, WITHOUT_ARRAY_WRAPPER\r\n            )\r\n        ) AS properties,\r\n        ROW_NUMBER() OVER\r\n        (\r\n            PARTITION BY ts.ModuleId\r\n            ORDER BY t.TabID\r\n        ) AS rn\r\n    FROM dbo.avtTabsPro_Settings ts\r\n    INNER JOIN dbo.Modules m\r\n        ON m.ModuleID = ts.ModuleId\r\n    INNER JOIN dbo.TabModules tm\r\n        ON m.ModuleID = tm.ModuleID\r\n    INNER JOIN dbo.Tabs t\r\n        ON tm.TabID = t.TabID\r\n    WHERE ts.Name = 'WidgetProvider'\r\n      AND ISNULL(ts.Value, '') <> 'Bootstrap5'\r\n      AND tm.IsDeleted = 0\r\n)\r\nSELECT\r\n(\r\n    SELECT\r\n        resourceId,\r\n        severity,\r\n        properties\r\n    FROM TabsProCTE\r\n    WHERE rn = 1\r\n    FOR JSON PATH\r\n) AS PAASysAlerts;",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
            "LastModifiedBy": null
